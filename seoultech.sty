%% 학위논문 작성 요령에 따른 글자 크기 / 굵기
\newcommand{\titlesizebf}[1]{{\huge \textbf{#1}}}
\newcommand{\subtitlesizebf}[1]{{\Large \textbf{#1}}}
\newcommand{\sumtitlesizebf}[1]{\Large {#1}}
\newcommand{\datesizebf}[1]{{\Large \textbf{#1}}}
\newcommand{\datesizenormal}[1]{{\Large #1}}
\newcommand{\writtenconsentsizebf}[1]{{\large \textbf{#1}}}
\newcommand{\writtenconsentsizenormal}[1]{{\large #1}}

%% 클리어엠티더블페이지
\newcommand{\cedp}{\newpage{\pagestyle{empty}\cleardoublepage}}

%% 겉표지
\newcommand{\makefrontcover}{%
  \thispagestyle{empty} \noindent%  
  \vskip 3.5cm %
  \datesizebf{\englishnameof@paper} \\ %
  \begin{center}

    \vskip 1cm %
    \titlesizebf{\korean@title} \\
	\titlesizebf{\english@title} \\    
    \vfill %
    \vskip 2cm %
    \datesizebf{by} \\ %
            
		\datesizebf{\english@authorname} \\ %    
            \vskip 2cm %
            \datesizenormal{\english@graduatedate} \\%
		\vskip 2.5cm %
		\datesizenormal{\english@departmentname} \\ %    
  
    \subtitlesizebf{The Graduate School \\ Seoul National University of Science and Technology} \\ %
    \vskip 2cm %
		
  \end{center}
  \newpage %
}

\newcommand{\refereesign}[1]{\underline{\makebox[3cm][s]{\texttt{#1}}}}
\newcommand{\refereevskip}{1cm}

%% 영문제출문
\newcommand{\englishproposal}{%
  \thispagestyle{empty} \noindent%
  \begin{center}
    \vskip 3.5cm
    \titlesizebf{\english@title} \\ %
    \vskip 1.5cm		    
		\subtitlesizebf{by} \\
		\subtitlesizebf{\english@authorname} \\
    \vskip 1.8cm
    \sumtitlesizebf{A \englishnameof@paper~ submitted to the
		\english@departmentname~ at the Graduate School of the
		Seoul National University of Science and Technology in partial fulfillment of the requirements
		for the degree of \englishnameof@degree} \\ %
    \vskip 0.9cm
    \datesizenormal{\english@graduatedate} \\%
    \vfill 
    \subtitlesizebf{Approved by} \\ %    
    \subtitlesizebf{\english@advisorname} \\ %    
		\subtitlesizebf{Advisor} \\ %      
  \end{center}
  \newpage
}

% 인준서도장명령정의
\newcommand{\putat}[3]{\begin{picture}(0,0)(0,0)\put(#1,#2){#3}\end{picture}}
%% 대부분의 경우 위 명령 필요 없음. 
%% 인준서 원본을 제본집에 보내면 컬러 복사로 넣어줌.
%% 이후 재제본을 위해 컬러 복사된 인준서 1부는 반드시 보관해둘 것. 

%% 영문 인준서
\newcommand{\makeenglishapproval}{%
  \thispagestyle{empty} \noindent%
  \begin{center}
    \vskip 35mm%
    \datesizenormal{This certifies that master thesis of \\ \english@authorname \ is approved.} \\ %
    \vskip 15mm %
    \begin{center}
      \begin{tabular}{lll}
		
        \subtitlesizebf{Committee Chairman: }  & \referee@chief &  \\ \\ %
	
        \subtitlesizebf{Committee Member: } & \referee@second  & \\ \\ %
	
        \subtitlesizebf{Committee Member: } & \referee@third  & \\ \\  %
	
    \end{tabular}
    \end{center}
    \vfill%
    \subtitlesizebf{The Graduate School \\ Seoul National University of Science and Technology}
    \vfill%
    \datesizenormal{\english@graduatedate}%
  \end{center}
  \newpage
}
%% 영문 초록
\newenvironment{EnglishSummary}{%
\thispagestyle{plain}% 

  % \phantomsection % hyperref 패키지를 사용할 때 \addcontentsline 관련 오류 메세지를 없애기 위해  
  \begin{center}
    \titlesizebf{Abstract} \\ 
    \vskip 10mm
    \begin{flushleft}
    \sumtitlesizebf{Title: \english@title}
    \end{flushleft}
  \end{center}
  \vskip 8mm
}

%국문 초록
\newenvironment{KoreanAbstract}{%
  \thispagestyle{plain}% 
  \phantomsection 
  \addcontentsline{toc}{chapter}{국문초록}%  목차(TOC)에 삽입
  \begin{center}
    \subtitlesizebf{국문초록} \\ % 제목 -> 국문초록
  \end{center}\vskip 5mm
  \begin{flushleft}
  \sumtitlesizebf{Title: \english@title}
  \end{flushleft}
  \begin{flushright}
    \korean@authorname \\ %
    %% 아래 내용은 대학원장님과 상담 후 넣는 것으로 확정됨.
    (지도교수 : \korean@advisorname) \\
    \korean@departmentname \\ %
    일반 대학원 \\
    서울과학기술대학교
       
  \end{flushright}
  \vskip 5mm
}
{  \vfill  
  % \noindent \textbf{주요어휘:}~\key@wordskorean \\ %
  \medskip  
  \newpage
}

